# Template for /opt/ayudagente/.env on the server. Never committed with real values.
#
# Note:
#   Compose reads it twice, to interpolate ${...} and as the container environment, so every
#   compose call passes --env-file.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.ayudagente.help

# The frontend is the entry point; with DEBUG off it needs an explicit grant
CORS_ALLOWED_ORIGINS=https://ayudagente.help,https://www.ayudagente.help
API_KEYS=

# Loopback on non-default ports: unreachable from off the host by construction
DB_NAME=ayudagente
DB_USER=ayudagente
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

REDIS_PORT=6380
CELERY_BROKER_URL=redis://127.0.0.1:6380/0

# Celery forks one process per core by default, and 112 of them exhaust the 100 db connections
CELERY_CONCURRENCY=24

# Its own pool: an Apify run holds a slot for ~40s and must not block reading
HARVEST_CONCURRENCY=6

# A guard against a burst, not the pace: the pool sets that. Keep it above slots x 60 / seconds
EXTRACTION_RATE_LIMIT=240/m

# Bind-mounted to the host, where nginx serves it off disk
MEDIA_ROOT=/app/media

OPENAI_API_KEY=
OPENAI_MODEL_REASONING=gpt-5.6-terra
OPENAI_MODEL_EXTRACTION=gpt-5.6-terra
OPENAI_MODEL_TRIAGE=gpt-5.6-luna
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

GOOGLE_GEOCODING_API_KEY=
APIFY_TOKEN=

# How fast the loop beats once the workers are up. 60 for a demonstration somebody is watching
TICK_SECONDS=60
WATCH_SECONDS=60

# Per event, pauses it. Across every event, refused at the gate so raising it resumes at once
HARVEST_SPEND_CEILING_USD=10
HARVEST_SPEND_TOTAL_CEILING_USD=10
