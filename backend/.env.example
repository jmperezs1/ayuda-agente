SECRET_KEY=change-me
DEBUG=True

# One key per API consumer, comma separated. Empty closes /api/ to everyone
API_KEYS=
# Extra origins allowed to call the API. Ignored while DEBUG opens CORS to all
CORS_ALLOWED_ORIGINS=

DB_NAME=hackaton
DB_USER=hackaton
DB_PASSWORD=hackaton
DB_HOST=localhost
DB_PORT=5433

# OpenAI — one model per role (Sol: frontier, Terra: balanced, Luna: high volume)
OPENAI_API_KEY=
OPENAI_MODEL_REASONING=gpt-5.6-sol
OPENAI_MODEL_EXTRACTION=gpt-5.6-sol
OPENAI_MODEL_TRIAGE=gpt-5.6-luna
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

GOOGLE_GEOCODING_API_KEY=

# Apify. Without it the frontier decides where to look but nothing fetches a post
APIFY_TOKEN=

# How often the perpetual loop beats, in seconds
TICK_SECONDS=300
# How often USGS is polled for new disasters. Free: it proposes paused events, never harvests
WATCH_SECONDS=900
# Circuit breaker: past this an event is paused. 0 disables it
HARVEST_SPEND_CEILING_USD=10
